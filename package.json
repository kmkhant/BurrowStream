{
  "name": "burrow-stream",
  "version": "v1.0.0",
  "description": "Burrow Stream",
  "scripts": {
    "start": "vite build && electrobun dev",
    "build": "bun run build:mainview && bun run build:player && electrobun build",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run dev:mainview\" \"bun run start\"",
    "dev:player:hmr": "concurrently \"bun run dev:player\" \"bun run start\"",
    "build:player": "vite build --config vite.player.config.ts",
    "build:mainview": "vite build --config vite.config.ts",
    "build:views": "vite build --config vite.config.ts && vite build --config vite.player.config.ts",
    "dev:mainview": "vite --config vite.config.ts --port 5173",
    "dev:player": "vite --config vite.player.config.ts --port 5174",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable",
    "db:push": "bunx drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio --config=drizzle.config.ts",
    "db:introspect": "bunx drizzle-kit introspect --config=drizzle.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electrobun": "1.18.1",
    "lucide-react": "^1.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.21",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
